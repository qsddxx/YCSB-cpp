{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 ycsb-rocksdb", // 调试配置名称（自定义）
      "type": "cppdbg", // 调试类型（C++ 调试）
      "request": "launch", // 启动模式（launch=直接启动调试，attach=附加到已运行进程）
      "program": "${workspaceFolder}/builder/ycsb", // 可执行文件路径（关键！）
      // 说明：${workspaceFolder} 是 VSCode 打开的项目根目录，若 ycsb 在子目录，需补全路径（如 ${workspaceFolder}/bin/ycsb）
      "args": [ // 命令行参数（按原命令顺序拆分，每个参数单独一个字符串）
        "-run",
        "-threads",
        "1",
        "-db",
        "rocksdb",
        "-P",
        "/home/liyixian/YCSB-ELESTIC/workloads/workloadb",
        "-p",
        "limit.ops=1000"
      ],
      "stopAtEntry": true, // 是否在程序入口（main 函数）暂停（建议设为 true，方便调试开始）
      "cwd": "${workspaceFolder}", // 工作目录（默认项目根目录，若程序依赖相对路径，需与运行时一致）
      "environment": [], // 环境变量（默认空，需额外变量可添加，如 ["ROCKSDB_TRACE=1"]）
      "externalConsole": false, // 是否启用外部终端（建议 false，在 VSCode 内置终端输出）
      "MIMode": "gdb", // 调试器（Linux 下默认 gdb）
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}